# ============================================================
# このファイルは初期セットアップの参考。
# 通常は /setup スキルが .env.local を自動生成するので、
# 非エンジニアはこのファイルを直接編集する必要はありません。
# ============================================================

# ----------------------------------------------------------
# 必須: Vercel Personal Access Token
# Claude が Vercel CLI/API 経由でプロジェクト作成・環境変数設定・
# デプロイ等を行うために使う。
# 取得: https://vercel.com/account/tokens
#   - Token Name: claude-<repo-name> など任意
#   - Scope: 該当チーム（例: SOBA AI Driven）を選択
#   - Expiration: 任意（漏洩時は revoke で即無効化可能）
# /setup の最初にユーザーから受け取って .env.local に保存する
# ----------------------------------------------------------
VERCEL_TOKEN=

# ----------------------------------------------------------
# 必須: データベース（Neon PostgreSQL）
# /setup が development branch の接続文字列を入れる
# ----------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------
# 必須: 認証（Auth.js v5）
# /setup が openssl rand -base64 32 で自動生成
# ----------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ----------------------------------------------------------
# オプション: OAuth プロバイダー
# /add-auth 系の作業で Claude が必要に応じて追記
# ----------------------------------------------------------
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ----------------------------------------------------------
# オプション: フロントエンド種別ごとのキー
# /setup でフロント種別を選択するとここに追加される
# ----------------------------------------------------------
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# CHATWORK_API_TOKEN=
